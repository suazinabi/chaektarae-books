rules_version = '2';
// 북실북실 · 실제 사람끼리 교류 규칙
// 글은 로그인한 사람만 읽는다. 쓰기는 자기 것만. 남의 글에선 자기 하트·자기 신고 칸만 건드릴 수 있다.
// 운영자는 Firebase 콘솔에서 글을 지우거나 bans/{uid} 문서를 만들어 글쓰기를 막는다.
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function banned() { return exists(/databases/$(db)/documents/bans/$(request.auth.uid)); }
    function str(v, n) { return v is string && v.size() <= n; }

    match /users/{uid} {
      allow read: if signed();
      allow create, update: if signed() && request.auth.uid == uid && !banned()
        && request.resource.data.keys().hasOnly(['name', 'handle', 'bio', 'color', 'ts', 'age14'])
        && str(request.resource.data.name, 20) && request.resource.data.name.size() > 0
        && request.resource.data.handle is string && request.resource.data.handle.matches('^[a-z0-9_]{2,16}$')
        && str(request.resource.data.bio, 160)
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.age14 == true;
      allow delete: if signed() && request.auth.uid == uid;
    }

    match /handles/{h} {
      allow read: if signed();
      allow create: if signed() && !banned() && h.matches('^[a-z0-9_]{2,16}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }

    match /posts/{id} {
      allow read: if signed();
      allow create: if signed() && !banned()
        && request.resource.data.keys().hasOnly(['uid', 'x', 'ts', 'r', 'pu', 'q', 'lk', 'rp'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.x, 500) && request.resource.data.x.size() > 0
        && request.resource.data.ts == request.time
        && str(request.resource.data.r, 40) && str(request.resource.data.pu, 128)
        && request.resource.data.lk == {} && request.resource.data.rp == {}
        && (!('q' in request.resource.data) || (request.resource.data.q is map
            && request.resource.data.q.keys().hasOnly(['b', 'at'])
            && str(request.resource.data.q.b, 40) && request.resource.data.q.at is int));
      allow update: if signed() && !banned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lk', 'rp'])
        && request.resource.data.lk.diff(resource.data.lk).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.rp.diff(resource.data.rp).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.lk) || request.resource.data.lk[request.auth.uid] == true)
        && (!(request.auth.uid in request.resource.data.rp) || str(request.resource.data.rp[request.auth.uid], 40));
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }

    match /bans/{uid} {
      allow read: if signed() && request.auth.uid == uid;
    }
  }
}
